# Copy to .env and fill in. Only FRESHDESK_DOMAIN plus one credential set is required;
# every MERIDIAN_* key below is optional and shown with its default value.
# Point the connector at a different file with MERIDIAN_ENV_FILE=/path/to/file.

# --- Account (required) ----------------------------------------------------
# Bare subdomain ("acme") or full host ("support.acme.com")
FRESHDESK_DOMAIN=acme
# Override the derived API root only for a gateway, proxy or local emulator.
# https:// anywhere; http:// is accepted for loopback hosts only.
# MERIDIAN_BASE_URL=

# --- Authentication: api_key (default) or oauth ----------------------------
FRESHDESK_AUTH_MODE=api_key

# api_key mode (required when FRESHDESK_AUTH_MODE=api_key)
# Freshdesk profile settings -> "Your API Key"
FRESHDESK_API_KEY=

# oauth mode (all three required when FRESHDESK_AUTH_MODE=oauth)
# Credentials from the Freshworks developer portal
FRESHDESK_OAUTH_CLIENT_ID=
FRESHDESK_OAUTH_CLIENT_SECRET=
FRESHDESK_OAUTH_REFRESH_TOKEN=
FRESHDESK_OAUTH_TOKEN_URL=https://api.freshworks.com/crm/oauth/token

# --- Traffic shaping -------------------------------------------------------
# Outbound pace; lower it when other integrations share the account's hourly quota
MERIDIAN_REQUESTS_PER_MINUTE=50
# Retry budget per request, and the backoff curve bounds in seconds
MERIDIAN_MAX_RETRIES=4
MERIDIAN_RETRY_BASE_DELAY=0.5
MERIDIAN_RETRY_MAX_DELAY=30
MERIDIAN_REQUEST_TIMEOUT=20
# Response size caps (page size is clamped to Freshdesk's maximum of 100)
MERIDIAN_MAX_PAGE_SIZE=100
MERIDIAN_MAX_PAGES_PER_CALL=5

# --- Safety ----------------------------------------------------------------
# Mask customer emails, phone numbers and card-like digits before the model sees them
MERIDIAN_REDACT_PII=true
# Allow the single write tool (internal private notes). Off by default.
MERIDIAN_ALLOW_WRITES=false

# --- Runtime ---------------------------------------------------------------
# stdio (default), sse, or streamable-http
MERIDIAN_TRANSPORT=stdio
MERIDIAN_LOG_LEVEL=INFO
